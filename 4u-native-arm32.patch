 #include "host.h"
+#include "mh4n/memory.h"
 
 namespace mh4n::host {
 namespace {
@@ -88,7 +89,35 @@ std::size_t PageSize() {
     return static_cast<std::size_t>(sysconf(_SC_PAGESIZE));
 }
 
+// A region reserved before the process grew (ReserveEarlyGuestSpace, which the app calls before
+// anything large maps): Reserve() consumes it once, so the guest's address space keeps a hole of
+// its own on a 32-bit host.
+void* g_early_base = nullptr;
+std::size_t g_early_size = 0;
+
+void ReserveEarlyGuestSpace() {
+#if !defined(__aarch64__)
+    // A 32-bit host's address space fills up: the hole must be reserved before SDL and the GPU
+    // driver's libraries have mapped. Nothing to do on a 64-bit host.
+    if (g_early_base != nullptr) {
+        return;
+    }
+    const std::size_t size = static_cast<std::size_t>(kAddressSpaceSize + kGuardSize);
+    void* p = mmap(nullptr, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (p != MAP_FAILED) {
+        g_early_base = p;
+        g_early_size = size;
+    }
+#endif
+}
+
 void* Reserve(std::size_t size) {
+    if (g_early_base != nullptr && size <= g_early_size) {
+        void* p = g_early_base;
+        g_early_base = nullptr;
+        g_early_size = 0;
+        return p;
+    }
     void* p = mmap(nullptr, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
     return p == MAP_FAILED ? nullptr : p;
 }
