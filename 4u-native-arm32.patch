diff --git a/mh4n/native/src/memory/host_posix.cpp b/mh4n/native/src/memory/host_posix.cpp
index bf29baa..abf0231 100644
--- a/mh4n/native/src/memory/host_posix.cpp
+++ b/mh4n/native/src/memory/host_posix.cpp
@@ -17,6 +17,7 @@
