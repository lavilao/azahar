diff --git a/mh4n/port/src/fiber_arm32.S b/mh4n/port/src/fiber_arm32.S
new file mode 100644
index 0000000..ebafae6
--- /dev/null
+++ b/mh4n/port/src/fiber_arm32.S
@@ -0,0 +1,30 @@
+// ARMv7 (armeabi-v7a) fiber context switch for Android. Bionic has no ucontext routines, so this
+// saves and restores the callee-saved registers (AAPCS r4-r11, sp, lr, and the VFP d8-d15) and
+// returns into the other context. The layout must match Arm32Context in fiber.cpp; the
+// static_asserts there check the offsets.
+//
+//   void mh4u_fiber_switch(Arm32Context* from, Arm32Context* to);
+
+    .syntax unified
+    .text
+    .p2align 2
+    .globl mh4u_fiber_switch
+    .hidden mh4u_fiber_switch
+    .type mh4u_fiber_switch, %function
+mh4u_fiber_switch:
+    // r0 = from, r1 = to; r2 is scratch (caller-saved, dead per the ABI once SwitchTo returns)
+    stm r0, {r4-r11, lr}          // 0..31 r4-r11, 32 lr
+    str sp, [r0, #36]
+    add r2, r0, #40
+    vstm r2, {d8-d15}             // 40..103, eight full callee-saved VFP doubles
+
+    ldm r1, {r4-r11, lr}
+    ldr sp, [r1, #36]
+    add r2, r1, #40
+    vldm r2, {d8-d15}
+    ldr r0, [r1, #104]            // arg: r0 when the context is first entered; r0 is
+                                  // caller-saved, so loading it on every switch is safe
+    bx lr
+    .size mh4u_fiber_switch, .-mh4u_fiber_switch
