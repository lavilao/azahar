diff --git a/mh4n/native/include/mh4n/clock.h b/mh4n/native/include/mh4n/clock.h
index 4846716..158b8ce 100644
--- a/mh4n/native/include/mh4n/clock.h
+++ b/mh4n/native/include/mh4n/clock.h
@@ -30,6 +30,7 @@ inline constexpr u64 kNanosecondsPerSecond = 1000000000;
 // scheduler switch): the whole seconds (or whole tick-seconds) apart from the rest, which stays inside 64 bits, each
 // divided by a constant. Exact for every input, as the 128-bit forms they replace (kept below for the checks).
 namespace clock_detail {
+#if defined(__SIZEOF_INT128__)
 constexpr u64 NsToTicks128(u64 ns) {
     const unsigned __int128 ticks = static_cast<unsigned __int128>(ns) * kTicksPerSecond / kNanosecondsPerSecond;
     return ticks > ~u64{0} ? ~u64{0} : static_cast<u64>(ticks);
@@ -43,6 +44,41 @@ constexpr u64 TicksToNsCeil128(u64 ticks) {
         (static_cast<unsigned __int128>(ticks) * kNanosecondsPerSecond + kTicksPerSecond - 1) / kTicksPerSecond;
     return ns > ~u64{0} ? ~u64{0} : static_cast<u64>(ns);
 }
+#else
+// A 32-bit target has no __int128: the same three from a 64x64->128 schoolbook product and a
+// 128-by-<2^32 long division, both all-constexpr and exact for every input, so the checks below
+// and the overflow paths they feed keep their exactness there too (both constants are < 2^32).
+struct U128 { u64 hi, lo; };
+constexpr U128 Mul64(u64 a, u64 b) {
+    const u64 a0 = a & 0xFFFFFFFFull, a1 = a >> 32, b0 = b & 0xFFFFFFFFull, b1 = b >> 32;
+    const u64 p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0, p11 = a1 * b1;
+    const u64 mid = p10 + (p00 >> 32);             // no overflow: both sides stay under 2^64 - 2^31
+    const u64 mid2 = p01 + (mid & 0xFFFFFFFFull);
+    return {p11 + (mid >> 32) + (mid2 >> 32), (mid2 << 32) | (p00 & 0xFFFFFFFFull)};
+}
+constexpr u64 Div128BySmall(u64 hi, u64 lo, u64 d) {  // (hi:lo)/d for d < 2^32, saturating
+    const u64 q1 = hi / d, r1 = hi % d;               // the quotient passes 64 bits only when q1 is set
+    const u64 x = (r1 << 32) | (lo >> 32);
+    const u64 q2h = x / d, r2 = x % d;
+    const u64 y = (r2 << 32) | (lo & 0xFFFFFFFFull);
+    return q1 != 0 ? ~u64{0} : (q2h << 32) | (y / d);
+}
+constexpr u64 NsToTicks128(u64 ns) {
+    const U128 p = Mul64(ns, kTicksPerSecond);
+    return Div128BySmall(p.hi, p.lo, kNanosecondsPerSecond);
+}
+constexpr u64 TicksToNs128(u64 ticks) {
+    const U128 p = Mul64(ticks, kNanosecondsPerSecond);
+    return Div128BySmall(p.hi, p.lo, kTicksPerSecond);
+}
+constexpr u64 TicksToNsCeil128(u64 ticks) {
+    U128 p = Mul64(ticks, kNanosecondsPerSecond);
+    const u64 add = kTicksPerSecond - 1;
+    p.lo += add;
+    p.hi += (p.lo < add) ? 1 : 0;
+    return Div128BySmall(p.hi, p.lo, kTicksPerSecond);
+}
